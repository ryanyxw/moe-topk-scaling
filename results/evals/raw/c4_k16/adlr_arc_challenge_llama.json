      "doc_to_text": "def doc_to_text_llama( doc):\n    # NOTE: Some `doc[\"answerKey\"]`s are in numeric string format being one\n    # of {'1', '2', '3', '4', '5'}. We map them back to letters.\n    letters = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    query = f\"\"\"Question: {doc[\"question\"]}\"\"\"\n    for idx, c in enumerate(doc[\"choices\"][\"text\"]):\n        query += f\"\"\"\\n{letters[idx]}. {doc[\"choices\"][\"text\"][idx]}\"\"\"\n    query += \"\\nAnswer:\"\n\n    return query\n",
      "doc_to_target": "def doc_to_target_llama(doc):\n    # NOTE: Some `doc[\"answerKey\"]`s are in numeric string format being one\n    # of {'1', '2', '3', '4', '5'}. We map them back to letters.\n    num_to_letter = {\"1\": \"A\", \"2\": \"B\", \"3\": \"C\", \"4\": \"D\", \"5\": \"E\"}\n    doc[\"answerKey\"] = num_to_letter.get(doc[\"answerKey\"], doc[\"answerKey\"])\n    return [\"A\", \"B\", \"C\", \"D\", \"E\"].index(doc[\"answerKey\"])\n",
      "unsafe_code": false,
      "doc_to_choice": "def doc_to_choice_llama(doc):\n    letters = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n    choices = []\n    for idx, _ in enumerate(doc[\"choices\"][\"text\"]):\n        choices.append(f\"\"\"{letters[idx]}\"\"\")\n    return choices\n",
